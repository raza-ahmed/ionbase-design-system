{
  "name": "ionbase-ui",
  "version": "0.25.0",
  "description": "IonBase Design System — accessible React components, styles and design tokens in one package",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./meta": "./dist/meta/components.json",
    "./meta/index": "./dist/meta/index.json",
    "./meta/*": "./dist/meta/*",
    "./patterns": "./dist/meta/patterns/index.json",
    "./patterns/*": "./dist/meta/patterns/*",
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./tokens": "./dist/styles/tokens/index.css",
    "./tokens/*": "./dist/styles/tokens/*",
    "./tokens-js": {
      "types": "./dist/tokens-js.d.ts",
      "default": "./dist/tokens-js.js"
    },
    "./figma-map": "./dist/figma-map.json",
    "./llms.txt": "./llms.txt",
    "./stylelint-config": "./stylelint-config.js",
    "./eslint-plugin": "./eslint-plugin/index.js"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "accessibility",
    "react-aria",
    "figma",
    "ionbase"
  ],
  "files": [
    "dist",
    "eslint-plugin",
    "stylelint-config.js",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raza-ahmed/ionbase-design-system.git",
    "directory": "packages/ionbase-ui"
  },
  "homepage": "https://github.com/raza-ahmed/ionbase-design-system#readme",
  "bugs": {
    "url": "https://github.com/raza-ahmed/ionbase-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "node scripts/sync-tokens.mjs && tsc --build --force && node scripts/copy-css.mjs && node scripts/verify-client-boundaries.mjs && node scripts/verify-contrast.mjs && node scripts/build-meta.mjs && node scripts/verify-meta.mjs && node scripts/build-patterns.mjs && node scripts/verify-figma-map.mjs && node scripts/build-figma-descriptions.mjs && node scripts/build-llms.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/styles/*.css\"",
    "format": "prettier --check .",
    "icons:verify": "node scripts/verify-icons.mjs",
    "meta:build": "node scripts/build-meta.mjs",
    "meta:verify": "node scripts/build-meta.mjs && node scripts/verify-meta.mjs",
    "contrast": "node scripts/verify-contrast.mjs",
    "contrast:list": "node scripts/verify-contrast.mjs --list",
    "llms": "node scripts/build-llms.mjs",
    "patterns": "node scripts/build-patterns.mjs",
    "figma:map": "node scripts/verify-figma-map.mjs",
    "figma:descriptions": "node scripts/build-figma-descriptions.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "stylelint": "^16.0.0 || ^17.0.0",
    "stylelint-declaration-strict-value": "^1.10.0",
    "eslint": "^8.57.0 || ^9.0.0"
  },
  "dependencies": {
    "@react-stately/collections": "^3.13.1",
    "@react-types/shared": "^3.36.0",
    "react-aria": "^3.34.0",
    "react-stately": "^3.48.0"
  },
  "//devDependencies": "lucide-react is a devDependency, not a dependency: nothing in src/ imports it. It is here only so scripts/verify-icons.mjs can compare the installed icon set against the Figma page. Consumers pick their own icon library. There is deliberately NO dependency on @ionbase-ui/tokens — it is private and would publish as a version that does not exist on npm. Build ordering is expressed in turbo.json instead.",
  "devDependencies": {
    "lucide-react": "^1.27.0",
    "typescript": "^5.5.2"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    },
    "stylelint-declaration-strict-value": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  }
}
