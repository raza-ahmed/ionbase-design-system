{
  "name": "@ionbase-ui/tokens",
  "version": "0.1.0",
  "description": "IonBase design tokens — CSS custom properties and TypeScript exports from Figma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/index.css",
    "./css/*": "./dist/css/*"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "figma",
    "css-variables",
    "ionbase"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raza-ahmed/ionbase-design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/raza-ahmed/ionbase-design-system/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/raza-ahmed/ionbase-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/figma-to-dtcg.mjs && node scripts/build-css.mjs && node scripts/build-ts.mjs && tsc --watch",
    "build": "pnpm run tokens:dtcg && pnpm run tokens:audit && pnpm run tokens:tier && pnpm run tokens:verify && pnpm run tokens:css && pnpm run tokens:typography && pnpm run tokens:elevation && pnpm run tokens:ts && tsc",
    "tokens:dtcg": "node scripts/figma-to-dtcg.mjs",
    "tokens:verify": "node scripts/verify-code-syntax.mjs",
    "tokens:css": "node scripts/build-css.mjs",
    "tokens:ts": "node scripts/build-ts.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "tokens:audit": "node scripts/audit-names.mjs",
    "tokens:help": "node scripts/help.mjs",
    "tokens:renames": "node scripts/verify-renames.mjs",
    "tokens:sync": "node scripts/verify-export.mjs",
    "tokens:typography": "node scripts/build-typography.mjs",
    "tokens:elevation": "node scripts/build-elevation.mjs",
    "tokens:tier": "node scripts/verify-tier.mjs",
    "tokens:bindings": "node scripts/verify-bindings.mjs",
    "tokens:gate": "pnpm run tokens:audit && pnpm run tokens:tier && pnpm run tokens:verify && pnpm run tokens:bindings && pnpm run tokens:geometry",
    "tokens:geometry": "node scripts/verify-geometry.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^4"
  }
}
