{
  "name": "@ionbase/styles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/*": "./dist/css/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@ionbase/tokens": "workspace:*"
  }
}
