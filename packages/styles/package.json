{
  "name": "@ionbase-ui/styles",
  "version": "0.1.0",
  "description": "IonBase component styles — CSS for every React component, built on design tokens",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./css": "./dist/css/index.css",
    "./css/*": "./dist/css/*",
    "./src/*": "./src/*"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "ionbase",
    "ui"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raza-ahmed/ionbase-design-system.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/raza-ahmed/ionbase-design-system/tree/main/packages/styles#readme",
  "bugs": {
    "url": "https://github.com/raza-ahmed/ionbase-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@ionbase-ui/tokens": "workspace:*"
  }
}
