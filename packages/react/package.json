{
  "name": "@ionbase-ui/react",
  "version": "0.1.0",
  "description": "IonBase React components — accessible UI built with React Aria",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "accessibility",
    "react-aria",
    "ionbase"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raza-ahmed/ionbase-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/raza-ahmed/ionbase-design-system/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/raza-ahmed/ionbase-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ionbase-ui/styles": "workspace:*",
    "@react-stately/collections": "^3.13.1",
    "@react-types/shared": "^3.36.0",
    "react-aria": "^3.34.0",
    "react-stately": "^3.48.0"
  }
}
