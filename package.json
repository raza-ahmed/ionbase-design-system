{
  "name": "ionbase-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "sync:version": "node scripts/sync-version.mjs",
    "publish:tokens": "pnpm --filter @ionbase-ui/tokens publish --access public",
    "publish:styles": "pnpm --filter @ionbase-ui/styles publish --access public",
    "publish:icons": "pnpm --filter @ionbase-ui/icons publish --access public",
    "publish:react": "pnpm --filter @ionbase-ui/react publish --access public",
    "publish:packages": "pnpm build && pnpm publish:tokens && pnpm publish:styles && pnpm publish:icons && pnpm publish:react"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.6.0",
    "prettier": "^3.3.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "turbo": "^2.0.6",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.0.0"
  }
}
