# ---- Dependencies ----
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ---- Build output ----
dist/
build/
lib/
out/
*.tsbuildinfo

# ---- Turborepo ----
.turbo/

# ---- Vite ----
.vite/

# ---- Storybook ----
storybook-static/
*.storybook.log

# ---- Tokens (generated output) ----
# Committed source of truth is packages/tokens/src/figma/ — the flat Figma
# export. Everything below is derived from it by `pnpm build` and must not be
# hand-edited or reviewed:
packages/tokens/src/dtcg/
packages/tokens/src/generated/
packages/tokens/build/

# Copied into the published package by ionbase-ui/scripts/sync-tokens.mjs. Same
# rule: derived from packages/tokens/src/figma/, never hand-edited. Committing
# them would give the repo two sources of truth for every token value.
packages/ionbase-ui/src/tokens/
packages/ionbase-ui/src/styles/tokens/

# ---- Icons (generated output) ----
# Committed source of truth is packages/ionbase-icons/svg/ — the raw SVGs.
# Everything under src/ is emitted from them by scripts/generate.mjs. Same rule
# as the tokens above: derived, never hand-edited. Committing ~1700 generated
# .tsx files would also make every regeneration an unreviewable diff.
packages/ionbase-icons/src/

# ---- Tests / coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ---- Env & secrets ----
.env
.env.*
!.env.example
*.pem
figma-token*.txt

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

