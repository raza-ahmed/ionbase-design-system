# ---- Dependencies ----
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ---- Build output ----
dist/
build/
lib/
out/
*.tsbuildinfo

# ---- Turborepo ----
.turbo/

# ---- Vite ----
.vite/

# ---- Storybook ----
storybook-static/
*.storybook.log

# ---- Tokens (generated output) ----
# Committed source of truth is packages/tokens/src/figma/ — the flat Figma
# export. Everything below is derived from it by `pnpm build` and must not be
# hand-edited or reviewed:
packages/tokens/src/dtcg/
packages/tokens/src/generated/
packages/tokens/build/

# ---- Tests / coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ---- Changesets ----
# Keep .changeset/config.json and pending changesets; ignore nothing here by default.

# ---- Env & secrets ----
.env
.env.*
!.env.example
*.pem
figma-token*.txt

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ---- Caches ----
.cache/
.eslintcache
.stylelintcache

# ---- Editors / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

